<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # === BEGIN: QR 301 redirects generated on 2025-08-25 ===
  Redirect 301 /product/funky-tiles-ava-smoke-grey-gloss- https://staging.stiles.co.za/product/funky-tiles-ava-smoke-grey-gloss-50x300mm
  Redirect 301 /product/funky-tiles-nairobi-metro-blue-50x300mm/ https://staging.stiles.co.za/product/funky-tiles-nairobi-blue-gloss-50x300mm
  Redirect 301 /product/funky-tiles-nairobi-offwhite-gloss-50x300mm/ https://staging.stiles.co.za/product/funky-tiles-nairobi-off-white-gloss-50x300mm
  Redirect 301 /product/realonda-hex-white-265x510mm/ https://staging.stiles.co.za/product/realonda-hex-snow-265x510mm
  Redirect 301 /product/monocolour-romo-botella-gloss-75x300mm https://staging.stiles.co.za/product/monocolour-botella-liso-gloss-75x300mm
  Redirect 301 /product/funky-tiles-look-light-grey-matt-50x500mm https://staging.stiles.co.za/product/funky-tiles-look-light-grey-gloss-50x500mm
  Redirect 301 /product/funky-tiles-puro-nero-marquina-silk-matt-125x250mm https://staging.stiles.co.za/product/puro-nero-marquina-3d-silk-matt-125x250mm
  Redirect 301 /product/funky-tiles-puro-statuario-3d-silk-matt-125x250mm https://staging.stiles.co.za/product/puro-statuario-3d-silk-matt-125x250mm
  Redirect 301 /product/funky-tiles-cadaques-rosso-matt-70x280mm/ https://staging.stiles.co.za/product/cadaques-rosso-matt-70x280mm
  # === END: QR 301 redirects ===

  # Existing app rules
  RewriteRule ^index\.html$ - [L]
  
  # Exclude API directory from rewrite rules - let Apache handle it directly
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule . - [L]
  
  # Rewrite everything else to index.html (SPA routing)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]

</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache control for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML - short cache for dynamic content
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS and JavaScript - long cache for versioned assets
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images - long cache
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    
    # Fonts - long cache
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    
    # JSON and data files - medium cache
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 week"
    
    # PDFs and documents
    ExpiresByType application/pdf "access plus 1 month"
    
    # Default for other static files
    ExpiresDefault "access plus 1 month"
</IfModule>

# Cache-Control headers for better browser caching
<IfModule mod_headers.c>
    # Cache static assets (JS, CSS, images, fonts) for 1 year with immutable flag
    # Vite generates versioned assets with hashes, so they're safe to cache forever
    <FilesMatch "\.(js|css|woff|woff2|ttf|otf|eot|png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Cache JSON data files for 1 month (they may change)
    <FilesMatch "\.(json)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Don't cache HTML files (they're dynamic)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    
    # Don't cache PHP files
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Disable ETags (we use Cache-Control headers instead)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
